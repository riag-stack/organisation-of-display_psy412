        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="2.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="+" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="stimulusCode" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="from math import sin, cos, radians&amp;#10;&amp;#10;&amp;#10;target_value = str(target).strip().upper()&amp;#10;config_value = str(config).strip().lower()&amp;#10;orientation_value = int(orientation)&amp;#10;reflection_value = str(reflection).strip().lower() == 'true'&amp;#10;&amp;#10;&amp;#10;def make_hybrid_segments(x, y, size=0.14):&amp;#10;&amp;#10;    segments = [&amp;#10;        ((x, y + size/2), (x - size/2, y + size/2)),&amp;#10;        ((x, y + size/2), (x, y - size/2)),&amp;#10;        ((x, y), (x + size/2, y))&amp;#10;    ]&amp;#10;&amp;#10;    return segments&amp;#10;&amp;#10;&amp;#10;if config_value == 'inline':&amp;#10;&amp;#10;    hybrid_positions = [&amp;#10;        (-0.42, 0.35),&amp;#10;        (-0.21, 0.20),&amp;#10;        (0.00, 0.05),&amp;#10;        (0.21, -0.10),&amp;#10;        (0.42, 0.05)&amp;#10;    ]&amp;#10;&amp;#10;    target_x = 0.42&amp;#10;    target_y = -0.35&amp;#10;&amp;#10;else:&amp;#10;&amp;#10;    hybrid_positions = [&amp;#10;        (-0.42, 0.35),&amp;#10;        (-0.21, 0.20),&amp;#10;        (0.00, 0.05),&amp;#10;        (0.21, -0.10),&amp;#10;        (0.42, -0.25)&amp;#10;    ]&amp;#10;&amp;#10;    target_x = 0.42&amp;#10;    target_y = 0.05&amp;#10;&amp;#10;&amp;#10;all_segments = []&amp;#10;&amp;#10;&amp;#10;for x, y in hybrid_positions:&amp;#10;&amp;#10;    all_segments.extend(&amp;#10;        make_hybrid_segments(x, y)&amp;#10;    )&amp;#10;&amp;#10;&amp;#10;if target_value == 'F':&amp;#10;&amp;#10;    if config_value == 'inline':&amp;#10;&amp;#10;        target_segments = [&amp;#10;            ((target_x, target_y + 0.07),&amp;#10;             (target_x + 0.09, target_y + 0.07)),&amp;#10;&amp;#10;            ((target_x, target_y + 0.07),&amp;#10;             (target_x, target_y - 0.07)),&amp;#10;&amp;#10;            ((target_x, target_y),&amp;#10;             (target_x + 0.09, target_y))&amp;#10;        ]&amp;#10;&amp;#10;    else:&amp;#10;&amp;#10;        target_segments = [&amp;#10;            ((target_x, target_y + 0.08),&amp;#10;             (target_x + 0.12, target_y + 0.08)),&amp;#10;&amp;#10;            ((target_x, target_y + 0.08),&amp;#10;             (target_x, target_y - 0.08)),&amp;#10;&amp;#10;            ((target_x, target_y),&amp;#10;             (target_x + 0.10, target_y))&amp;#10;        ]&amp;#10;&amp;#10;else:&amp;#10;&amp;#10;    if config_value == 'inline':&amp;#10;&amp;#10;        target_segments = [&amp;#10;            ((target_x - 0.09, target_y + 0.07),&amp;#10;             (target_x + 0.09, target_y + 0.07)),&amp;#10;&amp;#10;            ((target_x, target_y + 0.07),&amp;#10;             (target_x, target_y - 0.07))&amp;#10;        ]&amp;#10;&amp;#10;    else:&amp;#10;&amp;#10;        target_segments = [&amp;#10;            ((target_x - 0.09, target_y + 0.07),&amp;#10;             (target_x + 0.09, target_y + 0.07)),&amp;#10;&amp;#10;            ((target_x, target_y + 0.07),&amp;#10;             (target_x, target_y - 0.07))&amp;#10;        ]&amp;#10;&amp;#10;&amp;#10;all_segments.extend(target_segments)&amp;#10;&amp;#10;&amp;#10;all_points = []&amp;#10;&amp;#10;&amp;#10;for start, end in all_segments:&amp;#10;&amp;#10;    all_points.append(start)&amp;#10;    all_points.append(end)&amp;#10;&amp;#10;&amp;#10;min_x = min(point[0] for point in all_points)&amp;#10;max_x = max(point[0] for point in all_points)&amp;#10;min_y = min(point[1] for point in all_points)&amp;#10;max_y = max(point[1] for point in all_points)&amp;#10;&amp;#10;&amp;#10;center_x = (min_x + max_x) / 2&amp;#10;center_y = (min_y + max_y) / 2&amp;#10;&amp;#10;&amp;#10;scale = 0.90&amp;#10;&amp;#10;&amp;#10;def transform_point(x, y):&amp;#10;&amp;#10;    x = x - center_x&amp;#10;    y = y - center_y&amp;#10;&amp;#10;    if reflection_value:&amp;#10;        x = -x&amp;#10;&amp;#10;    x = x * scale&amp;#10;    y = y * scale&amp;#10;&amp;#10;    angle = radians(orientation_value)&amp;#10;&amp;#10;    new_x = x * cos(angle) - y * sin(angle)&amp;#10;    new_y = x * sin(angle) + y * cos(angle)&amp;#10;&amp;#10;    return new_x, new_y&amp;#10;&amp;#10;&amp;#10;stimulus_lines = []&amp;#10;&amp;#10;&amp;#10;for start, end in all_segments:&amp;#10;&amp;#10;    new_start = transform_point(&amp;#10;        start[0],&amp;#10;        start[1]&amp;#10;    )&amp;#10;&amp;#10;    new_end = transform_point(&amp;#10;        end[0],&amp;#10;        end[1]&amp;#10;    )&amp;#10;&amp;#10;    line = visual.Line(&amp;#10;        win=win,&amp;#10;        start=new_start,&amp;#10;        end=new_end,&amp;#10;        lineColor='black',&amp;#10;        lineWidth=3&amp;#10;    )&amp;#10;&amp;#10;    stimulus_lines.append(line)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if t &gt;= 2.0 and t &lt; 2.05:&amp;#10;    for line in stimulus_lines:&amp;#10;        line.draw()&amp;#10; " valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stimulusCode" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="trialTimer" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
